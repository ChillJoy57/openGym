# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).

map $request_uri $api_request_uri {
    "~^\Q${BASE_PATH}\E(?<api_request_rest>/.*)$" $api_request_rest;
}

server {
    listen ${NGINX_PORT};
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;

    # API → backend container.
    location ^~ ${BASE_PATH}/api/ {
        client_max_body_size 5m;
        proxy_pass http://127.0.0.1:${BACKEND_PORT}$api_request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Photos and videos of custom exercises (PUT and GET under api/media/).
    location ^~ ${BASE_PATH}/api/media/ {
        client_max_body_size ${MEDIA_UPLOAD_MAX};
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://127.0.0.1:${BACKEND_PORT}$api_request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location ${BASE_PATH}/ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        try_files $uri $uri/ @root;
    }
    location @root {
        return 302 ${BASE_PATH}/$is_args$args;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;
    }

    location ^~ ${BASE_PATH}/exercise-media/ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;
        location ~* \.(png|jpg|jpeg|gif|webp|avif|mp4)$ {
            rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
            add_header Cache-Control "public, max-age=2592000, immutable";
            add_header Cross-Origin-Resource-Policy "same-origin" always;
            add_header X-Frame-Options "DENY" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "same-origin" always;
            add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;
        }
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif|mp4)$ {
        rewrite ^\Q${BASE_PATH}\E/(.*)$ /$1 break;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "${CONTENT_SECURITY_POLICY}" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
